# Variables d'environnement - Copiez ce fichier vers .env.local et remplissez les valeurs

# URL de base de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fournisseur de base de données: 'sqlite' pour le développement local, 'supabase' pour la production
NEXT_PUBLIC_DB_PROVIDER=sqlite

# --- Configuration Supabase (obligatoire si NEXT_PUBLIC_DB_PROVIDER=supabase) ---
# Créez un projet sur https://supabase.com et récupérez ces informations dans Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Autres options ---
# JWT secret pour les tokens d'authentification (à générer en production: openssl rand -hex 32)
JWT_SECRET=change-me-in-production-please

# Clé Stripe (optionnel - pour les abonnements entreprise)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Analytics (optionnel)
NEXT_PUBLIC_GA_ID=

# --- Notifications nouvelles offres (optionnel) ---
# Le scraper Python charge automatiquement .env.local / .env.
# Le lien public envoyé dans le message utilise NEXT_PUBLIC_APP_URL.
#
# Option A — webhook sortant vers n8n / Make / Zapier / Twilio / votre passerelle WhatsApp
WHATSAPP_WEBHOOK_URL=
#
# Option B — envoi direct via WhatsApp Cloud API (Meta)
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_TO=
WHATSAPP_META_API_VERSION=v23.0
